{
  "name": "gist-library-reservation-assistant",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "build:extension": "tsc --noEmit && vite build --config vite.extension.config.ts",
    "dev:extension": "vite build --watch --config vite.extension.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "test": "tsx --test server/*.test.ts extension/content/*.test.ts extension/panel/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
