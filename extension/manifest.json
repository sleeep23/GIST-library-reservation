{
  "manifest_version": 3,
  "name": "GIST Library Reservation Assistant",
  "version": "0.1.1",
  "description": "Shows the GIST Library reservation assistant inside the official library reservation page.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://library.gist.ac.kr/*",
    "https://library.gist.ac.kr:8443/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://library.gist.ac.kr/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
